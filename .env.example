# ===== 必填 =====
# DeepSeek API Key：只放服务端，不要写进前端、不要发到群里
DEEPSEEK_API_KEY=sk-在这里填你的key

# 管理员密码：打开 /admin 生成验证码时用，建议 20 位以上随机字符串
ADMIN_TOKEN=换成一串很长的随机密码

# ===== 部署 =====
# 本地：http://localhost:3000；线上填你的域名，例如 https://phone.example.com
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
HOST=0.0.0.0

# 数据目录：Render / Railway 挂载持久盘后改成 /var/data
DATA_DIR=./data

# ===== DeepSeek =====
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=1800
DEEPSEEK_TIMEOUT_MS=75000

# ===== 额度与防刷 =====
# 单个验证码最多能用几次（上限 10）
MAX_CODE_QUOTA=10
# 验证码有效期（天）
CODE_TTL_DAYS=30
# 同一 IP 在 10 分钟内最多请求几次
RATE_MAX=12
RATE_WINDOW_MIN=10
# 同一 IP 每天最多请求几次（含输错码）
IP_DAILY_MAX=30
# 全站每天最多调用几次 DeepSeek（保护钱包）
GLOBAL_DAILY_MAX=200
# 部署在 Nginx / Render / Railway 代理后面时设为 1，才能取到真实 IP
TRUST_PROXY=0
